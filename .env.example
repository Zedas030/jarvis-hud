# ═══════════════════════════════════════════════════════════════════════════
#  JARVIS — configuration
#  Copy to .env and fill in. .env is in .gitignore and stays local.
#  Empty value = feature off. None of this belongs in a repository.
# ═══════════════════════════════════════════════════════════════════════════

# ── Profile ─────────────────────────────────────────────────────────────────
# How Jarvis addresses the user. Empty = neutral ("User").
JARVIS_USER_NAME=
# Place for weather and briefing (display) and coordinates (open-meteo.com)
JARVIS_PLACE=
JARVIS_WEATHER_LAT=50.11
JARVIS_WEATHER_LON=8.68
JARVIS_TIMEZONE=Europe/Berlin
# Browser for the HUD and for "open website" (full path). Empty = default browser.
JARVIS_BROWSER=
JARVIS_OPEN=1

# ── Brain (Claude Code on the Claude subscription) ──────────────────────────
# NEVER set ANTHROPIC_API_KEY — billing would go through the API instead of the subscription.
# 1 = lean mode (own prompt, tool groups, no session), 0 = session mode
JARVIS_LEAN=1
# Simple commands without an LLM (home, music, time, weather, systems)
JARVIS_LOCAL_ROUTER=1
JARVIS_MODEL_SIMPLE=haiku
JARVIS_MODEL_SMART=sonnet
JARVIS_MODEL=sonnet
JARVIS_EFFORT=low
JARVIS_MAX_OUTPUT_TOKENS=1500
JARVIS_HISTORY_TURNS=4
JARVIS_HISTORY_MAX_AGE_MIN=30
JARVIS_TIMEOUT=180
# Session mode (JARVIS_LEAN=0): permissions and session size
JARVIS_PERMISSION=acceptEdits
JARVIS_ALLOWED_TOOLS=Read,Glob,Grep,WebSearch,WebFetch
JARVIS_SESSION_MAX_TOKENS=50000
# Daily briefing: facts from code; 1 = one short Haiku call phrases them, 0 = plain text
JARVIS_BRIEFING_LLM=1
# Identical read-only questions are answered from the cache for this many seconds (0 = off)
JARVIS_CACHE_S=300

# ── Server ──────────────────────────────────────────────────────────────────
JARVIS_PORT=8720
# Working folder = memory: the only place Jarvis may write without confirmation
JARVIS_WORKDIR=vault
JARVIS_DEMO=0

# ── Remote access (iPhone/iPad via Tailscale) ───────────────────────────────
# 1 = device port on 127.0.0.1:JARVIS_REMOTE_PORT, published with: tailscale serve --bg 8721
JARVIS_REMOTE=0
JARVIS_REMOTE_PORT=8721
# Allowed host names, comma-separated. Empty = any *.ts.net name
JARVIS_REMOTE_HOSTS=

# ── Voice: provider chain ───────────────────────────────────────────────────
# Order; empty/exhausted providers are skipped until their reset.
TTS_CHAIN=fish,elevenlabs,local,azure,google,edge
# Short announcement when the provider changes
TTS_ANNOUNCE_SWITCH=1

# Fish Audio — https://fish.audio/app/api-keys/
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_LATENCY=balanced

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# eleven_flash_v2_5 = fast; eleven_v3 = expressive with [tags]
ELEVENLABS_MODEL=eleven_flash_v2_5

# Local GPU voice (local_tts_server.py, environment .venv-tts) — fallback: Piper on the CPU
LOCAL_TTS_URL=http://127.0.0.1:8730

# Azure Speech (free tier F0: 0.5 M characters/month) — portal.azure.com → Speech service
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_VOICE=de-DE-FlorianMultilingualNeural

# Google Cloud Text-to-Speech (free tier, account with billing required)
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=de-DE-Chirp3-HD-Charon

# Microsoft Edge (free, last resort)
JARVIS_TTS=edge
EDGE_VOICE=de-DE-FlorianMultilingualNeural
EDGE_RATE=+5%

# ── Listening ───────────────────────────────────────────────────────────────
# local = Whisper on this PC (GPU if available), elevenlabs = Scribe (credits)
JARVIS_STT=local
ELEVENLABS_STT_LANG=deu
# Words Whisper should spell reliably (names, devices, services)
WHISPER_LOCAL_PROMPT=Jarvis, Sir, Spotify, Home Assistant, Raspberry Pi, NAS, Claude, Briefing

# ── Wake word ───────────────────────────────────────────────────────────────
# off  = every utterance counts
# text = only sentences starting with "Jarvis …" (nothing to install)
# oww  = openWakeWord listens locally for "Hey Jarvis"; falls back to "text" if missing
#        .venv\Scripts\python.exe -m pip install openwakeword sounddevice
JARVIS_WAKE=off
JARVIS_WAKE_MODEL=hey_jarvis
JARVIS_WAKE_THRESHOLD=0.5
# Microphone for openWakeWord (name or index per sounddevice), empty = default
JARVIS_WAKE_DEVICE=
# Seconds the mic stays open after "Jarvis" / after each answer without the wake word
JARVIS_WAKE_WINDOW_S=7
JARVIS_FOLLOWUP_S=8

# ── Proactive messages ──────────────────────────────────────────────────────
# Timers, alarms and reminders always ring. Notices (washing machine done,
# appointment soon, new device …) are only shown during quiet hours.
JARVIS_PROACTIVE=1
JARVIS_QUIET_HOURS=22-7
# Announce this many minutes before an appointment, 0 = off
JARVIS_EVENT_LEAD_MIN=15
# Report the battery as "full" from this charge level (once a day, 10–17 h)
JARVIS_STORAGE_FULL=98
# Appliances with power meters: config/home.json → "appliances" (template in home.example.json)

# ── Commute ─────────────────────────────────────────────────────────────────
# Starting point for travel times; empty = the weather coordinates
JARVIS_HOME_LAT=
JARVIS_HOME_LON=
JARVIS_TRAFFIC_FACTOR=1.25
JARVIS_COMMUTE_BUFFER_MIN=5
JARVIS_LEAVE_WARN_MIN=5

# ── PC and volume ───────────────────────────────────────────────────────────
# Music volume share while Jarvis speaks (0 = no ducking), apps to duck
JARVIS_DUCK=0.3
JARVIS_DUCK_APPS=spotify.exe
# Share of the voice volume during quiet hours
JARVIS_NIGHT_VOLUME=0.5

# ── Lists ───────────────────────────────────────────────────────────────────
# To-do entity in Home Assistant (then also visible in the HA app), empty = a note in the vault
JARVIS_SHOPPING_LIST=todo.shopping_list
JARVIS_TODO_LIST=

# ── Stand-in brains when Claude is down or the limit is reached ─────────────
# Tried in this order; providers without a key are skipped. ollama = local, off = disabled.
JARVIS_FALLBACK=groq,gemini,ollama
# Groq free tier — https://console.groq.com/keys (fast, no training on your data)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Google AI Studio free tier — https://aistudio.google.com/apikey
# (free-tier prompts may be used for training, so Gemini never sees mail, calendar or health)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Local and offline. Once: ollama pull qwen2.5:7b-instruct
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Providers allowed to see private requests (mail, calendar, health, briefing)
JARVIS_FALLBACK_PRIVATE=groq,ollama

# ── Calendar (iCloud / CalDAV) ──────────────────────────────────────────────
# App-specific password: account.apple.com → Sign-In and Security
ICLOUD_USER=
ICLOUD_APP_PASSWORD=
# ICLOUD_CALENDARS=Private,Work
# ICLOUD_DEFAULT_CALENDAR=Private

# ── Email (IMAP, read-only) ─────────────────────────────────────────────────
MAIL_IMAP_HOST=
MAIL_USER=
MAIL_PASSWORD=

# ── Smart home (Home Assistant) ─────────────────────────────────────────────
HA_URL=http://homeassistant.local:8123
# Long-lived access token: HA profile → Security
HA_TOKEN=
# Optional: MCP server in Home Assistant (automations, history, logs) — loaded only when needed
HA_MCP_URL=
# Device mapping for the dashboard: config/home.json (template config/home.example.json)

# ── Home network ────────────────────────────────────────────────────────────
# Raspberry Pi / home server via SSH key (read-only status command without confirmation)
JARVIS_PI_HOST=
JARVIS_PI_USER=pi
# Synology NAS (dedicated DSM user, read-only)
SYNOLOGY_URL=
SYNOLOGY_USER=
SYNOLOGY_PASSWORD=

# ── Health (Garmin Connect) ─────────────────────────────────────────────────
GARMIN_EMAIL=
GARMIN_PASSWORD=

# ── API credit in $ (optional) ──────────────────────────────────────────────
# Anthropic key for the Cost API — do NOT enter it as ANTHROPIC_API_KEY
JARVIS_COST_KEY=
