# ═══════════════════════════════════════════════════════════════════════════
#  JARVIS — configuration
#  Copy to .env and fill in. .env is in .gitignore and stays local.
#  Empty values = feature off. None of this belongs in a repository.
#  Rotating a secret: create the new key at the provider, replace it here, restart Jarvis
#  (⟳ Restart in the HUD reads .env again), then revoke the old key at the provider.
# ═══════════════════════════════════════════════════════════════════════════

# ── Profile ─────────────────────────────────────────────────────────────────
# How Jarvis addresses the user. Empty = neutral ("User").
JARVIS_USER_NAME=
# Place for weather and briefing (display) and coordinates (open-meteo.com)
JARVIS_PLACE=
JARVIS_WEATHER_LAT=50.11
JARVIS_WEATHER_LON=8.68
JARVIS_TIMEZONE=Europe/Berlin
# Browser for the HUD and for "open website" (full path). Empty = default browser.
JARVIS_BROWSER=
JARVIS_OPEN=1
# Mini window on the desktop while the HUD tab is not visible (0 = off).
# Look: panda (robot panda with faces) or card (old card with orb).
JARVIS_OVERLAY=1
JARVIS_OVERLAY_STYLE=panda

# ── Brain (Claude Code through the Claude subscription) ─────────────────────
# NEVER set ANTHROPIC_API_KEY — otherwise billing goes through the API instead of the subscription.
# 1 = lean mode (own prompt, tool groups, no session), 0 = session mode
JARVIS_LEAN=1
# Simple commands without an LLM (house, music, time, weather, systems)
JARVIS_LOCAL_ROUTER=1
JARVIS_MODEL_SIMPLE=haiku
JARVIS_MODEL_SMART=sonnet
JARVIS_MODEL=sonnet
JARVIS_EFFORT=low
JARVIS_MAX_OUTPUT_TOKENS=1500
JARVIS_HISTORY_TURNS=4
JARVIS_HISTORY_MAX_AGE_MIN=30
JARVIS_TIMEOUT=180
# Session mode (JARVIS_LEAN=0): permissions and session size
JARVIS_PERMISSION=acceptEdits
JARVIS_ALLOWED_TOOLS=Read,Glob,Grep,WebSearch,WebFetch
JARVIS_SESSION_MAX_TOKENS=50000
# Daily briefing: facts in code, 1 = one short Haiku call words it, 0 = plain text
JARVIS_BRIEFING_LLM=1

# ── Server ──────────────────────────────────────────────────────────────────
# Log logs/jarvis.log (JSON lines): level INFO; single modules on DEBUG, e.g. voice_engine,router
JARVIS_LOG_LEVEL=INFO
JARVIS_LOG_DEBUG=
JARVIS_PORT=8720
# Working folder = memory: only here may Jarvis write without confirmation
JARVIS_WORKDIR=vault
JARVIS_DEMO=0

# ── Voice: provider chain ───────────────────────────────────────────────────
# Order; empty or used-up providers are skipped until their reset.
TTS_CHAIN=fish,elevenlabs,local,azure,google,edge
# Short announcement when the provider changes
TTS_ANNOUNCE_SWITCH=1

# Fish Audio — https://fish.audio/app/api-keys/
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
# The voice model decides the language; pick an English voice on fish.audio
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_LATENCY=balanced

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# eleven_flash_v2_5 = fast; eleven_v3 = expressive with [tags]
ELEVENLABS_MODEL=eleven_flash_v2_5
# Language of the spoken answer (ISO 639-1)
ELEVENLABS_LANG=en

# Local GPU voice (local_tts_server.py, environment .venv-tts) — fallback: Piper on the CPU
# (model models/piper/en_GB-alan-medium.onnx, see docs/installation.md)
LOCAL_TTS_URL=http://127.0.0.1:8730

# Azure Speech (free tier F0: 0.5 million characters/month) — portal.azure.com → Speech service
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_VOICE=en-GB-RyanNeural

# Google Cloud Text-to-Speech (free tier, account with billing needed)
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=en-GB-Chirp3-HD-Charon

# Microsoft Edge (free, last resort)
JARVIS_TTS=edge
EDGE_VOICE=en-GB-RyanNeural
EDGE_RATE=+5%

# ── Listening ───────────────────────────────────────────────────────────────
# local = Whisper on this PC (GPU if available), elevenlabs = Scribe (credits)
JARVIS_STT=local
# Language Whisper expects (ISO 639-1; empty = detect it each time, slower and less reliable)
WHISPER_LOCAL_LANG=en
ELEVENLABS_STT_LANG=eng
# Words Whisper should spell reliably (names, devices, services)
WHISPER_LOCAL_PROMPT=Jarvis, Sir, Spotify, Home Assistant, Raspberry Pi, NAS, Claude, Briefing

# ── Voice engine ────────────────────────────────────────────────────────────
# Listening, end of sentence, interrupting and resuming run on the server (config/voice.yaml:
# thresholds, times, port 8724). This variable points to another config file; empty = config/voice.yaml.
# Once: .venv\Scripts\python.exe scripts\fetch_voice_models.py (Silero VAD into models/).
#JARVIS_VOICE_CONFIG=

# ── Wake word ───────────────────────────────────────────────────────────────
# off  = every utterance counts (as before)
# text = only sentences that start with "Jarvis …" (nothing to install)
# oww  = openWakeWord listens locally for "Hey Jarvis"; if it is missing, "text" applies
#        .venv\Scripts\python.exe -m pip install openwakeword sounddevice
JARVIS_WAKE=off
JARVIS_WAKE_MODEL=hey_jarvis
JARVIS_WAKE_THRESHOLD=0.5
# Microphone for openWakeWord (name or number according to sounddevice), empty = default
JARVIS_WAKE_DEVICE=
# Seconds the mic stays open after "Jarvis" / after every answer without the wake word
JARVIS_WAKE_WINDOW_S=7
JARVIS_FOLLOWUP_S=8
# Wake word directly on the iPad/iPhone (once: scripts\fetch_wakeword.py). From this score on a
# clip goes to the PC. "Hey Jarvis" reaches ~0.99, a bare "Jarvis" ~0.03–0.1.
# A clip up to 8 s (a normal request) only has to be above 0.004, except with music/sport in the room.
# logs/wake_device.log shows every clip with its score — if "Jarvis" does not get through, lower it here.
JARVIS_WAKE_LOCAL_THRESHOLD=0.02
# Which model on the device decides: hey_jarvis (official, "Hey Jarvis"), jarvis_v1 or
# jarvis_v2 (community, "Jarvis" only; v1 more sensitive, v2 fewer false alarms). The others run
# along for comparison and are logged with their score in logs/wake_device.log. The threshold above
# fits hey_jarvis — after switching, set it anew from the log.
JARVIS_WAKE_LOCAL_MODEL=hey_jarvis
# Background detection: Home Assistant reports media players that are playing (music, sport, TV); then
# "Jarvis" only counts at the start/end of a sentence and the display suggests "Hey Jarvis". 0 = mic only.
JARVIS_AMBIENCE=1
# Media players that can never be heard in the room (regex on entity_id or name)
JARVIS_AMBIENCE_IGNORE=

# ── Spotify (all devices of the account, also the phone on the stereo) ────────
# On "Jarvis" the music goes very quiet (or pauses) so that he understands you clearly, then back as before.
# "Music off", "next track" then also reach the phone. Needs Premium (Family is enough).
# Once: create an app on developer.spotify.com, redirect URI http://127.0.0.1:8722/callback,
# tick Web API, enter the client id here, then  .venv\Scripts\python.exe scripts\spotify_login.py
# (the refresh token is then stored in config/spotify_token.json; delete it and log in again to rotate it)
JARVIS_SPOTIFY_CLIENT_ID=
# 0 = do not pause on the wake word (music commands still go through the account)
JARVIS_SPOTIFY_HOLD=1
# The music plays again after this many seconds at the latest, if the HUD does not report back
JARVIS_SPOTIFY_HOLD_MAX_S=120
# quiet = music keeps playing at JARVIS_SPOTIFY_QUIET_FACTOR of its volume (0.3 = a third), at most
# JARVIS_SPOTIFY_QUIET_PCT percent, and then comes back to the old volume; applies on "Jarvis" and on every
# announcement. pause = stop as before. Devices whose volume Spotify cannot set are paused.
JARVIS_SPOTIFY_HOLD_MODE=quiet
JARVIS_SPOTIFY_QUIET_FACTOR=0.3
JARVIS_SPOTIFY_QUIET_PCT=20

# ── Sonos ───────────────────────────────────────────────────────────────────
# Answers of a device (e.g. iPad) on a Sonos instead of from the device, as an announcement through Home
# Assistant: music gets quieter and plays on afterwards. Switch in the HUD ("🔈 Sound here"), on the iPad
# under ⋯. List: media_player.x=Name, several with commas. Empty = off. The Sonos fetches the clips from
# http://<PC address>:JARVIS_SONOS_PORT (GET only, random name, valid for 10 minutes, private addresses only).
JARVIS_SONOS=
JARVIS_SONOS_PORT=8723
# JARVIS_SONOS_HOST=10.0.0.145   # empty = the address through which Home Assistant is reachable
JARVIS_SONOS_VOLUME=0.35
# At night (JARVIS_QUIET_HOURS) the Sonos speaks this loud and returns to its own volume afterwards
JARVIS_SONOS_NIGHT_VOLUME=0.1
# As with Alexa: music on this device's Sonos goes to this volume while Jarvis listens,
# thinks and answers (also applies to AirPlay and the Sonos app). Afterwards the old one comes back.
JARVIS_SONOS_QUIET=0.12

# ── Room awareness (jarvis/core/room_scope.py) ─────────────────────────────
# Commands without a room ("light on", "warmer", "TV on") mean the room the presence sensors see me in
# (config/home.json → presence_room, room_scope). 0 = off, then everything is as before.
JARVIS_ROOM_SCOPE=1
# "warmer" / "colder": this many degrees per command; a switched-off heating goes to DEFAULT on "warmer"
JARVIS_CLIMATE_STEP=1
JARVIS_CLIMATE_DEFAULT=20
# How long the last room still counts when Home Assistant does not answer (seconds)
JARVIS_PRESENCE_STALE_S=300

# ── Speaking up by himself ──────────────────────────────────────────────────
# Timers, alarms and reminders always ring. Notices (washing machine done,
# appointment soon, new device …) are only shown during quiet hours.
JARVIS_PROACTIVE=1
JARVIS_QUIET_HOURS=22-7
# Minutes before an appointment to announce it, 0 = off
JARVIS_EVENT_LEAD_MIN=15
# Report the battery as "full" from this charge level (once a day, 10–17 h)
JARVIS_STORAGE_FULL=98
# Devices with a power meter: config/home.json → "appliances" (template in home.example.json)

# ── Lists ───────────────────────────────────────────────────────────────────
# To-do entity in Home Assistant (then also visible in the HA app), empty = note in the vault
JARVIS_SHOPPING_LIST=todo.shopping_list
JARVIS_TODO_LIST=

# ── Replacement brain when Claude fails or the limit is reached ─────────────
# Chain in this order, all with the same tools and confirmation cards.
# off = off. If a key is missing, that link is skipped.
JARVIS_FALLBACK=groq,gemini,ollama
# Who may see private conversations (mail, calendar, health) — Gemini free may train on them
JARVIS_FALLBACK_PRIVATE=groq,ollama
# Groq free tier (console.groq.com), no training on the data
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Google AI Studio free tier (aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Local and offline. Once: ollama pull qwen2.5:7b-instruct
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# ── Appointments from mails (mail_events.py) ─────────────────────────────────
# Every 30 minutes from JARVIS_MAIL_EVENTS_HOUR until 22 h. 0 = off.
JARVIS_MAIL_EVENTS_DAILY=1
JARVIS_MAIL_EVENTS_HOUR=7
# Jarvis enters bookings from these sender domains (also subdomains) without a card, with a notice and "undo".
JARVIS_MAIL_EVENTS_TRUSTED=pccaddie-online.de,golftimer.de,golfhouse.de

# ── Web search ──────────────────────────────────────────────────────────────
# 1 = every request to Claude may search the web when notes and tools are not enough
# (private data never goes into the search). 0 = only when the sentence asks for it.
JARVIS_WEB_ALWAYS=1

# ── Remote access (iPhone/iPad through Tailscale, see docs/usage.md) ───────────
# 1 = second port only for paired devices, reachable through "tailscale serve"
JARVIS_REMOTE=0
JARVIS_REMOTE_PORT=8721
# Allowed host names, comma-separated (empty = everything under *.ts.net)
JARVIS_REMOTE_HOSTS=

# ── Calendar (iCloud / CalDAV) ──────────────────────────────────────────────
# App-specific password: account.apple.com → Sign-In and Security
ICLOUD_USER=
ICLOUD_APP_PASSWORD=
# ICLOUD_CALENDARS=Private,Work
# ICLOUD_DEFAULT_CALENDAR=Private

# ── Proactive mode (docs/proactive.md; behaviour in config/proactive.yaml) ───────────
# 1/0 overrides "enabled" from the YAML (e.g. in a container); empty = the YAML decides
JARVIS_PROACTIVE_MODE=
# JARVIS_PROACTIVE_CONFIG=config/proactive.yaml
# JARVIS_PROACTIVE_HISTORY=logs/proactive_history.jsonl

# ── E-mail (IMAP, read only) ────────────────────────────────────────────────
MAIL_IMAP_HOST=
MAIL_USER=
MAIL_PASSWORD=
# optional: name under which Jarvis mentions the account
MAIL_NAME=
# More accounts: MAIL2_…, MAIL3_… (up to MAIL9_), same fields. Jarvis reads all of them;
# drafts go to the first one unless another one is named ("draft from Gmail").
# MAIL2_IMAP_HOST=imap.gmail.com
# MAIL2_USER=
# MAIL2_PASSWORD=
# MAIL2_NAME=Gmail
# How far back Jarvis looks at most (inbox, appointments from mails, parcels), in hours.
JARVIS_MAIL_LOOKBACK_HOURS=24

# ── Parcel tracking (shipments.py) ──────────────────────────────────────────
# Deliveries from the shipping mails -> all-day calendar entry, reminder on the delivery day. 0 = off.
JARVIS_SHIPMENTS=1
# Live status and delivery day for all carriers (DHL, Hermes, DPD, GLS, UPS ...): key from
# 17track.net (account -> API). Free allowance; only the first registration of a shipment uses it up.
# 17TRACK then sees the tracking numbers.
TRACK17_API_KEY=
# Alternatively DHL only, directly at DHL (developer.dhl.com, "Shipment Tracking - Unified")
DHL_API_KEY=
# Same-day delivery services and groceries: no shipment for the calendar (comma list of domains)
JARVIS_SHIPMENTS_IGNORE=uber.com,ubereats.com,goflink.com,wolt.com,lieferando.de,deliveroo.de,getir.com,gorillas.io,knuspr.de,picnic.app,rewe.de,flaschenpost.de

# ── Smart home (Home Assistant) ─────────────────────────────────────────────
HA_URL=http://homeassistant.local:8123
# Long-lived access token: HA profile → Security (rotate: create a new one there, replace it here, delete the old one)
HA_TOKEN=
# Optional: MCP server in Home Assistant (automations, history, logs) — only loaded when needed
HA_MCP_URL=
# Device mapping for the dashboard: config/home.json (template config/home.example.json)
# Entity ids default to English HA names (a German HA instance names them differently, e.g.
# _derzeitiger_verbrauch instead of _current_consumption — then set the JARVIS_PLUG_* suffixes)
# JARVIS_PLUG_POWER_SUFFIX=_current_consumption
# JARVIS_PLUG_MONTH_SUFFIX=_this_month_s_consumption
# JARVIS_HOUSE_MONTH=sensor.house_consumption_this_month
# 3D printer (Bambu, integration ha-bambulab): found by itself. With several printers
# enter the entity prefix here (e.g. x1c_0123456789abcde), 0 = no printer questions and announcements.
JARVIS_PRINTER=
# Heartbeat for the crash watchdog in HA (heartbeat.py): Jarvis stamps input_datetime.jarvis_heartbeat
# every minute. Set up with: .venv\Scripts\python.exe scripts\heartbeat_ha_setup.py
# When the PC draws more than JARVIS_HEARTBEAT_PC_WATT (80) and no stamp comes for 10 min, a push goes to
# JARVIS_PHONE_NOTIFY. Enter the power sensor of the PC's smart plug in W (e.g. sensor.pc_power);
# JARVIS_HEARTBEAT=0 stops the stamping.
JARVIS_HEARTBEAT_PC_POWER=
JARVIS_HEARTBEAT_PC_WATT=80
JARVIS_HEARTBEAT=1
# Home Assistant in real time over the WebSocket (ha_events.py); 0 = poll every 30 s as before
JARVIS_HA_WS=1
# A sensor that switches more often than this per hour does not wake the watchers for an hour (0 = no filter)
JARVIS_HA_WS_NOISY=30

# ── Home network ────────────────────────────────────────────────────────────
# Raspberry Pi / home server by SSH key (only a read-only status command without asking)
JARVIS_PI_HOST=
JARVIS_PI_USER=pi
# Homelab figures (homelab.py). Prometheus and Pi-hole default to the Pi above.
# PIHOLE_PASSWORD: an app password from Pi-hole -> Settings -> Web interface / API.
PROMETHEUS_URL=
PIHOLE_URL=
PIHOLE_PASSWORD=
# Situation report (situation.py), defaults to the Pi above. Uptime Kuma is read from a public
# status page with this slug (Kuma -> Status pages -> new page, add all monitors).
KUMA_URL=
JARVIS_KUMA_SLUG=jarvis
# ORBIT security centre (report at /api/security) and how old its last scan may be
JARVIS_ORBIT_URL=
JARVIS_ORBIT_STALE_HOURS=2
# Electricity price in euros per kWh for the electricity costs (power_costs.py)
JARVIS_POWER_PRICE=0.35
# Check when leaving the flat (away_check.py): minutes away before he checks; 0 = off
JARVIS_AWAY_MINUTES=3
JARVIS_AWAY_CHECK=1
# Weekly report on the home network on Sunday (homelab_review.py)
JARVIS_HOMELAB_REVIEW=1
# Welcome back: only after this many minutes away (away_check.py)
JARVIS_WELCOME_MINUTES=20
# Severe weather from the DWD through Bright Sky (weather_alerts.py): from which level (minor, moderate, severe, extreme)
JARVIS_WEATHER_ALERTS=1
JARVIS_ALERTS_MIN=moderate
# Habits in the house (house_habits.py): on this many days at the same time = habit
JARVIS_HABITS=1
JARVIS_HABITS_MIN_DAYS=4
# Morning briefing in the living room (morning_echo.py): from this hour, until JARVIS_BRIEFING_UNTIL
JARVIS_MORNING_ECHO=1
JARVIS_MORNING_FROM=5
# Answers through the Echo: this many characters Alexa speaks per second (alexa_voice.py)
JARVIS_ALEXA_CHARS_PER_S=15
# At night (JARVIS_QUIET_HOURS) the Echo speaks at this volume, then the old volume comes back
JARVIS_ALEXA_NIGHT_VOLUME=0.2
# Synology NAS (own DSM user, read only)
SYNOLOGY_URL=
SYNOLOGY_USER=
SYNOLOGY_PASSWORD=
# FRITZ! repeaters without their own HA integration, comma-separated (updates.py reads their version
# without login and compares it with download.avm.de; report only)
JARVIS_FRITZ_REPEATERS=

# ── Health (Garmin Connect) ─────────────────────────────────────────────────
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Garmin as a trigger (wellbeing.py): poor night = gentle morning (until JARVIS_WB_UNTIL h)
JARVIS_WELLBEING=1
JARVIS_WB_SLEEP_LOW=60
JARVIS_WB_STRESS_HIGH=50
JARVIS_WB_BATTERY_LOW=30
JARVIS_WB_UNTIL=12
# in the evening from this hour: Body Battery below this = a hint at an early evening
JARVIS_WB_EVENING=21
JARVIS_WB_BATTERY_EVENING=25
JARVIS_WB_VOLUME=0.75

# ── Smarter: habits, setting off, budget, maintenance, voice, focus, self-check ──────────
# The user's habits (user_habits.py): the same question on this many days at the same time
JARVIS_USER_HABITS=1
JARVIS_USER_HABITS_MIN_DAYS=4
# Before setting off to an appointment (departure.py): this many minutes before the time to leave
JARVIS_DEPARTURE_PREP_MIN=30
# Monthly electricity budget in euros (power_costs.py), 0 = off; alternatively budget_eur in config/energy_coach.json
JARVIS_POWER_BUDGET_EUR=0
# Maintenance calendar (maintenance.py): certificates, Docker images, backup age from config/homelab.json → maintenance
JARVIS_MAINTENANCE=1
# Voice by time of day (daytime.py): whisper in these hours (empty = quiet hours), quieter/slower from LATE_FROM
JARVIS_DAYTIME_VOICE=1
JARVIS_WHISPER_HOURS=
JARVIS_LATE_FROM=21
JARVIS_LATE_VOLUME=0.8
JARVIS_LATE_SPEED=1.08
# Focus sessions (focus.py): default length, hint after this many minutes of distraction, window titles that distract
JARVIS_FOCUS_DEFAULT_MIN=45
JARVIS_FOCUS_WARN_MIN=10
# JARVIS_FOCUS_DISTRACT=youtube|netflix|twitch|reddit|twitter|instagram|tiktok
# Self-check (selfcheck.py): a rephrased question within this many seconds = a miss
JARVIS_SELFCHECK_SECONDS=25
# Phone as a card (phone_actions.py): the helper in Home Assistant into which the automation writes the answer
JARVIS_PHONE_ACTION_ENTITY=input_text.jarvis_phone_action

# ── Token budget per week (token_budget.py): announced at 80 and 100 %, 0 = off ──────────
JARVIS_TOKEN_BUDGET_WEEK=2000000
JARVIS_TOKEN_BUDGET_WARN=80,100

# ── Memory: saving by himself, search index, NAS store (docs/memory.md) ─────────────────
# Lasting facts from conversations saved without a card (0 = off), at most this many per conversation
JARVIS_REMEMBER=1
JARVIS_REMEMBER_MAX=3
# Store on the NAS with the SYNOLOGY_* login above; 0 = off. Folder on the NAS, daily zips kept,
# hours without an upload before the homelab watcher reports it
JARVIS_MEMORY_NAS=1
JARVIS_MEMORY_NAS_DIR=/home/Jarvis-Memory
JARVIS_MEMORY_NAS_KEEP=90
JARVIS_MEMORY_NAS_STALE_H=48
# Sundays: what Jarvis saved by himself this week (keep it or strike a point by number)
JARVIS_MEMORY_WEEKLY=1
JARVIS_MEMORY_WEEKLY_TIME=18:30
# Kuma alarms via HA (event jarvis_alert): offer to restart a container, 0 = only announce
JARVIS_KUMA_RESTART=1

# ── Home and everyday life (2026-11-10 evening) ─────────────────────────────
# Night report of the presence sensors (night_report.py): window in hours, not before, from this many pulses;
# the room tracker helper in HA
JARVIS_NIGHT_REPORT=1
JARVIS_NIGHT_WINDOW=0-6
JARVIS_NIGHT_REPORT_TIME=07:30
JARVIS_NIGHT_GHOSTS=5
JARVIS_ROOM_ENTITY=input_select.room_tracker
# Airing tip from this humidity, mould warning above this one (airing.py)
JARVIS_AIRING=1
JARVIS_AIR_TIP_RH=60
JARVIS_AIR_MOULD_RH=65
# Birthdays from the memory on the day before (birthdays.py)
JARVIS_BIRTHDAYS=1
JARVIS_BIRTHDAY_TIME=18:00
# "Why is … on?": this many hours back in the HA logbook (ha_why.py)
JARVIS_WHY_HOURS=24

# ── Paperless-ngx (scanned post, read only) ─────────────────────────────────
PAPERLESS_URL=
PAPERLESS_TOKEN=

# ── UniFi (network controller, read only): API key or user ──────────────────
UNIFI_URL=
UNIFI_API_KEY=
UNIFI_USER=
UNIFI_PASSWORD=
UNIFI_SITE=default
UNIFI_VERIFY_TLS=0

# ── Jellyfin (media library): playback on devices with the Jellyfin app ─────
JELLYFIN_URL=
JELLYFIN_API_KEY=
JELLYFIN_USER=
JELLYFIN_TV=fire

# ── API credit in $ (optional) ──────────────────────────────────────────────
# Anthropic key for the Cost API — do NOT enter it as ANTHROPIC_API_KEY
JARVIS_COST_KEY=
